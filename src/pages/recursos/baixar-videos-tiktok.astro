---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTA from '../../components/CTA.astro';
import FAQ from '../../components/FAQ.astro';
import Icon from '../../components/Icon.astro';
import InstallButton from '../../components/InstallButton.astro';
import ProductShot from '../../components/ProductShot.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SINGLE_VIDEO_FAQS } from '../../data/faqs';
import { breadcrumbSchema, faqSchema } from '../../lib/schema';

const title = 'Baixar vídeos do TikTok — Baixora';
const description =
  'Baixe um vídeo do TikTok sem marca d’água quando houver fonte limpa, em HD quando disponível, com nome de arquivo personalizado. Extensão para Chrome.';
const jsonLd = [
  breadcrumbSchema([
    { name: 'Início', href: '/' },
    { name: 'Recursos', href: '/recursos/' },
    { name: 'Download de um vídeo', href: '/recursos/baixar-videos-tiktok/' },
  ]),
  faqSchema(SINGLE_VIDEO_FAQS),
];

const filenameTemplates = [
  ['título', 'A descrição do vídeo, ajustada para virar nome de arquivo.'],
  ['dataPublicação_título', 'Data de publicação seguida da descrição do vídeo.'],
  ['dataPublicação_idVid', 'Data de publicação seguida do ID do vídeo.'],
  ['usuário_dataPublicação_título', 'Nome de usuário, data de publicação e descrição.'],
] as const;

const limits = [
  'Nem todo vídeo expõe uma fonte reproduzível. Sem fonte, não há download.',
  'A saída em HD e sem marca d’água depende da fonte que o TikTok fornece para aquele vídeo.',
  'A Baixora não recodifica a mídia, então não remove uma marca d’água que faz parte da única fonte.',
  'Conteúdo privado, removido, bloqueado por região ou disponível só após login está fora do escopo.',
  'Uma URL de mídia pode expirar. Atualize a página e tente de novo se o download falhar.',
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/recursos/baixar-videos-tiktok/"
  jsonLd={jsonLd}
>
  <section class="border-b border-slate-200 bg-slate-50">
    <div class="container-page py-10 sm:py-14">
      <Breadcrumbs
        items={[
          { name: 'Início', href: '/' },
          { name: 'Recursos', href: '/recursos/' },
          { name: 'Download de um vídeo', href: '/recursos/baixar-videos-tiktok/' },
        ]}
      />
      <div class="mt-8 grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-600">
            Download de um vídeo
          </p>
          <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">
            Baixar um vídeo do TikTok
          </h1>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">
            Abra um vídeo público, use o controle de download da Baixora e salve a melhor
            fonte que a página disponibiliza. Escolha um formato de nome de arquivo e
            reaproveite em todos os downloads.
          </p>
          <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-500">
            A saída sem marca d’água e em HD depende da fonte que o TikTok fornece. A
            Baixora não edita nem recodifica o arquivo.
          </p>
          <div class="mt-7 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
            <InstallButton
              campaign="feature-single-video"
              label="Adicionar ao Chrome"
            />
            <a
              href="/guias/como-baixar-videos-do-tiktok/"
              class="text-sm font-semibold text-brand-700 hover:underline"
            >
              Ler o guia de download de um vídeo
            </a>
          </div>
        </div>
        <ProductShot id="single-download" priority />
      </div>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-20">
    <div class="container-page">
      <div class="grid gap-5 md:grid-cols-3">
        {[
          ['Um controle na página', 'A Baixora adiciona um controle a páginas e cards públicos compatíveis. Sem dashboard separado nem etapa de upload.'],
          ['Progresso e cancelamento', 'Um download em andamento mostra o progresso. Clique novamente no controle ativo para cancelar a requisição atual.'],
          ['Formatos de nome', 'Use título, data, ID do vídeo ou nome de usuário para manter os arquivos fáceis de reconhecer.'],
        ].map(([heading, text]) => (
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
            <h2 class="text-base font-bold text-slate-950">{heading}</h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white py-14 sm:py-20">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <SectionHeading
          eyebrow="Qualidade"
          title="Baixar vídeos sem marca d’água, quando a fonte permite."
          description="A Baixora não inventa uma versão de qualidade superior. Ela solicita a fonte limpa em HD quando o TikTok oferece uma e recorre ao que estiver disponível."
        />
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
          <ul class="space-y-3 text-sm leading-6 text-slate-600">
            <li class="flex gap-3"><Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-brand-600" />Saída sem marca d’água quando a página expõe uma fonte limpa.</li>
            <li class="flex gap-3"><Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-brand-600" />HD quando a página fornece um stream HD; SD caso contrário.</li>
            <li class="flex gap-3"><Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-brand-600" />Saída em MP4, salva pelo fluxo normal de download do navegador.</li>
            <li class="flex gap-3"><Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-brand-600" />Sem recodificação, filtros, sobreposições ou extração de áudio.</li>
          </ul>
          <p class="mt-5 rounded-xl bg-white p-4 text-xs leading-5 text-slate-500">
            A qualidade varia por vídeo. Um vídeo pode ser público e ainda assim não ter
            fonte reproduzível, ter uma fonte de qualidade menor ou ter uma marca d’água
            que faz parte do único arquivo exposto pelo TikTok.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-14 sm:py-20">
    <div class="container-page">
      <SectionHeading
        eyebrow="Formatos de nome"
        title="Facilite encontrar os arquivos depois."
        description="Escolha um padrão de nome no popup ou nas configurações da extensão antes de começar."
      />
      <div class="mt-8 overflow-x-auto rounded-2xl border border-slate-200 bg-white">
        <table class="w-full border-collapse text-left text-sm">
          <caption class="sr-only">Opções de formato de nome de arquivo da Baixora</caption>
          <thead class="bg-slate-50">
            <tr>
              <th scope="col" class="px-3 py-3 font-bold text-slate-900 sm:px-5 sm:py-3.5">Formato</th>
              <th scope="col" class="px-3 py-3 font-bold text-slate-900 sm:px-5 sm:py-3.5">O que usa</th>
            </tr>
          </thead>
          <tbody>
            {filenameTemplates.map(([name, description]) => (
              <tr class="border-t border-slate-100">
                <th scope="row" class="px-3 py-3 font-semibold text-slate-800 sm:px-5 sm:py-3.5">{name}</th>
                <td class="px-3 py-3 text-slate-600 sm:px-5 sm:py-3.5">{description}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white py-14 sm:py-20">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
        <SectionHeading
          eyebrow="Fluxo"
          title="Da página do vídeo para um arquivo local."
          description="Um download único não deve precisar de um segundo aplicativo."
        />
        <ol class="space-y-4">
          {[
            ['Abra um vídeo público', 'Use uma página de detalhe ou um feed público compatível. Deixe a página terminar de renderizar.'],
            ['Clique no controle de download', 'A extensão resolve a melhor fonte disponível e inicia o download.'],
            ['Acompanhe o progresso', 'Mantenha a página aberta até o arquivo ser salvo. Clique novamente no controle ativo para cancelar.'],
            ['Encontre o arquivo', 'O MP4 é salvo pelo fluxo do navegador com o formato de nome que você escolheu.'],
          ].map(([step, text], index) => (
            <li class="flex gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
              <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">
                {index + 1}
              </span>
              <div>
                <h3 class="text-sm font-bold text-slate-950">{step}</h3>
                <p class="mt-1.5 text-sm leading-6 text-slate-600">{text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-20">
    <div class="container-page">
      <SectionHeading eyebrow="Limites" title="O que esperar quando um vídeo não baixa." />
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {limits.map((limit) => (
          <div class="flex gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm leading-6 text-slate-600">
            <Icon name="alert" class="mt-0.5 h-4 w-4 shrink-0 text-signal-500" />
            <p>{limit}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white py-14 sm:py-20">
    <div class="container-page">
      <div class="rounded-3xl border border-amber-200 bg-amber-50 p-6 sm:p-8">
        <div class="flex gap-4">
          <Icon name="alert" class="mt-0.5 h-6 w-6 shrink-0 text-amber-600" />
          <div>
            <h2 class="text-lg font-bold text-slate-950">Baixe apenas conteúdo que você tem o direito de usar.</h2>
            <p class="mt-2 max-w-3xl text-sm leading-7 text-slate-700">
              Siga a lei aplicável, os termos do TikTok e as permissões do dono do conteúdo.
              A Baixora não fornece permissão legal e não contorna controles de acesso, DRM
              ou outras restrições. Disponibilidade não é o mesmo que autorização.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-14 sm:py-20">
    <div class="container-page">
      <SectionHeading eyebrow="FAQ" title="Dúvidas sobre vídeo único." align="center" />
      <div class="mx-auto mt-8 max-w-4xl">
        <FAQ items={SINGLE_VIDEO_FAQS} />
      </div>
    </div>
  </section>

  <CTA
    campaign="feature-single-video-final"
    title="Salve o próximo vídeo que você abrir."
    description="Instale a Baixora e use o controle de download em um vídeo público do TikTok. As funções principais são grátis; o Premium libera o fluxo completo em lote."
    secondaryHref="/guias/como-baixar-videos-do-tiktok/"
    secondaryLabel="Ler o guia de um vídeo"
  />
</BaseLayout>
