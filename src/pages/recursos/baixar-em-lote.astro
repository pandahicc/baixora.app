---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTA from '../../components/CTA.astro';
import FAQ from '../../components/FAQ.astro';
import Icon from '../../components/Icon.astro';
import InstallButton from '../../components/InstallButton.astro';
import ProductShot from '../../components/ProductShot.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BULK_DOWNLOAD_FAQS } from '../../data/faqs';
import { SITE, SUPPORTED_PAGES } from '../../data/site';
import { breadcrumbSchema, faqSchema } from '../../lib/schema';

const title = 'Baixador de vídeos do TikTok em lote — Baixora';
const description =
  'Baixador de vídeos do TikTok: selecione vídeos de pesquisas, Explorar, hashtags ou perfis e baixe em ZIP ou em uma pasta. Grátis para instalar.';
const jsonLd = [
  breadcrumbSchema([
    { name: 'Início', href: '/' },
    { name: 'Recursos', href: '/recursos/' },
    { name: 'Download em lote', href: '/recursos/baixar-em-lote/' },
  ]),
  faqSchema(BULK_DOWNLOAD_FAQS),
];

const limits = [
  'A Baixora só trabalha com os vídeos que a página retorna ou renderiza. Uma lista é uma amostra, não um índice completo do TikTok.',
  `O plano Grátis tem limite diário para download em lote, exportação e playlists — por padrão, ${SITE.freeDailyLimit} itens por dia. O Premium libera o fluxo completo; o limite atual aparece na extensão.`,
  'Um vídeo pode não ter fonte reproduzível ou expor uma URL expirada. Itens com falha são informados separadamente.',
  'A Baixora não contorna login, CAPTCHA, bloqueio regional, DRM ou limites de taxa.',
  'O ZIP é gerado pelo fluxo de download do navegador; salvar em pasta exige escolher e autorizar uma pasta.',
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/recursos/baixar-em-lote/"
  jsonLd={jsonLd}
>
  <section class="border-b border-slate-200 bg-slate-50">
    <div class="container-page py-10 sm:py-14">
      <Breadcrumbs
        items={[
          { name: 'Início', href: '/' },
          { name: 'Recursos', href: '/recursos/' },
          { name: 'Download em lote', href: '/recursos/baixar-em-lote/' },
        ]}
      />
      <div class="mt-8 grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-600">
            Download em lote
          </p>
          <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">
            Baixar vídeos do TikTok em lote
          </h1>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">
            A Baixora é um baixador de vídeos do TikTok focado em lote: monte uma seleção
            em resultados de pesquisa, Explorar, hashtags ou em um perfil de criador e
            salve em ZIP ou em uma pasta.
          </p>
          <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-500">
            A seleção é a fonte de verdade para o download e para a exportação. A
            disponibilidade depende do que a página pública expõe.
          </p>
          <div class="mt-7 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
            <InstallButton campaign="feature-bulk-download" label="Adicionar ao Chrome" />
            <a
              href="/guias/como-baixar-videos-do-tiktok-em-lote/"
              class="text-sm font-semibold text-brand-700 hover:underline"
            >
              Ler o guia de download em lote
            </a>
          </div>
        </div>
        <ProductShot id="search-list" priority />
      </div>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-20">
    <div class="container-page">
      <div class="grid gap-5 md:grid-cols-3">
        {[
          ['Adicione de listas compatíveis', 'Use o controle de adicionar nos cards de pesquisa, Explorar, hashtag ou perfil. Selecione itens individualmente ou use os controles da página.'],
          ['Saída em ZIP ou pasta', 'O ZIP vira um arquivo único pelo fluxo do navegador. Salvar em pasta grava MP4 individuais em um local escolhido por você.'],
          ['Progresso e falhas', 'Acompanhe o lote e revise os itens com falha. Um item com problema não interrompe o restante da fila.'],
        ].map(([heading, text]) => (
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
            <h2 class="text-base font-bold text-slate-950">{heading}</h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white py-14 sm:py-20">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <SectionHeading
          eyebrow="ZIP ou pasta"
          title="Escolha a saída que combina com o lote."
          description="As duas opções usam a mesma seleção. A diferença está em como os arquivos chegam ao computador."
        />
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-white text-brand-700 shadow-sm">
              <Icon name="zip" class="h-5 w-5" />
            </span>
            <h2 class="mt-4 text-base font-bold text-slate-950">Baixar um ZIP</h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              Melhor para um lote menor que você quer mover como um arquivo único. O ZIP
              é gerado localmente e salvo pelo navegador.
            </p>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-white text-brand-700 shadow-sm">
              <Icon name="folder" class="h-5 w-5" />
            </span>
            <h2 class="mt-4 text-base font-bold text-slate-950">Salvar em uma pasta</h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              Melhor para um lote maior ou para revisão posterior. O navegador pede que
              você escolha uma pasta e conceda permissão de escrita antes de gravar.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-14 sm:py-20">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
        <div>
          <SectionHeading
            eyebrow="Fluxo"
            title="Monte a seleção e inicie o lote."
            description="A seleção é a fonte de verdade para o download e para a exportação."
          />
          <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5">
            <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">
              Onde funciona
            </p>
            <ul class="mt-3 flex flex-wrap gap-2">
              {SUPPORTED_PAGES.map((page) => (
                <li class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-medium text-slate-700">
                  {page}
                </li>
              ))}
            </ul>
            <p class="mt-3 text-xs leading-5 text-slate-500">
              Páginas de vídeo aceitam o download individual; as listas e perfis aceitam a
              seleção em lote.
            </p>
          </div>
        </div>
        <ol class="space-y-4">
          {[
            ['Abra uma lista compatível', 'Resultados de pesquisa, Explorar, uma hashtag ou um perfil de criador. Deixe a página carregar antes de adicionar itens.'],
            ['Adicione os vídeos', 'Use o controle de adicionar em cada card ou os controles de seleção da página, quando disponíveis.'],
            ['Confira a contagem', 'Confirme a quantidade selecionada antes de começar. Mudar um filtro não deve alterar silenciosamente o que já foi selecionado.'],
            ['Escolha ZIP ou pasta', 'Inicie o lote e escolha a saída. Para salvar em pasta, aprove o aviso de seleção de pasta do navegador.'],
            ['Revise as falhas', 'Confira os itens com falha, atualize a página se uma URL de mídia expirar e tente novamente a seleção.'],
          ].map(([step, text], index) => (
            <li class="flex gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
              <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">
                {index + 1}
              </span>
              <div>
                <h3 class="text-sm font-bold text-slate-950">{step}</h3>
                <p class="mt-1.5 text-sm leading-6 text-slate-600">{text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white py-14 sm:py-20">
    <div class="container-page">
      <SectionHeading eyebrow="Limites" title="O que um lote cobre e o que não cobre." />
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {limits.map((limit) => (
          <div class="flex gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm leading-6 text-slate-600">
            <Icon name="alert" class="mt-0.5 h-4 w-4 shrink-0 text-signal-500" />
            <p>{limit}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-20">
    <div class="container-page">
      <div class="rounded-3xl border border-amber-200 bg-amber-50 p-6 sm:p-8">
        <div class="flex gap-4">
          <Icon name="alert" class="mt-0.5 h-6 w-6 shrink-0 text-amber-600" />
          <div>
            <h2 class="text-lg font-bold text-slate-950">Um lote não é uma licença.</h2>
            <p class="mt-2 max-w-3xl text-sm leading-7 text-slate-700">
              Baixar um vídeo público não dá o direito de republicá-lo, usá-lo em um
              anúncio ou apresentá-lo como seu. Siga a lei aplicável, os termos do TikTok e
              as permissões do dono do conteúdo.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-slate-50 py-14 sm:py-20">
    <div class="container-page">
      <SectionHeading eyebrow="FAQ" title="Dúvidas sobre download em lote." align="center" />
      <div class="mx-auto mt-8 max-w-4xl">
        <FAQ items={BULK_DOWNLOAD_FAQS} />
      </div>
    </div>
  </section>

  <CTA
    campaign="feature-bulk-final"
    title="Transforme uma página de vídeos em uma pasta."
    description="Instale a Baixora, abra uma página pública de lista e baixe a seleção. O Premium libera o fluxo completo em lote."
    secondaryHref="/guias/como-baixar-videos-do-tiktok-em-lote/"
    secondaryLabel="Ler o guia de download em lote"
  />
</BaseLayout>
