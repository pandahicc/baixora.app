---
import Icon from './Icon.astro';

interface Props {
  feature: {
    title: string;
    href: string;
    icon: string;
    description: string;
  };
  emphasized?: boolean;
}

const { feature, emphasized = false } = Astro.props;
---

<a
  href={feature.href}
  class:list={[
    'group flex h-full flex-col rounded-2xl border shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md',
    emphasized
      ? 'border-brand-300 bg-brand-50/50 p-7 hover:border-brand-400 sm:p-8'
      : 'border-slate-200 bg-white p-6 hover:border-brand-300',
  ]}
>
  {
    emphasized && (
      <span class="mb-4 inline-flex w-fit items-center gap-1.5 rounded-full bg-brand-600 px-3 py-1 text-[0.7rem] font-bold uppercase tracking-[0.1em] text-white">
        <span class="h-1.5 w-1.5 rounded-full bg-white/80" />
        Fluxo principal
      </span>
    )
  }
  <span
    class:list={[
      'mb-5 inline-flex items-center justify-center rounded-xl bg-brand-50 text-brand-700',
      emphasized ? 'h-12 w-12' : 'h-11 w-11',
    ]}
  >
    <Icon name={feature.icon} class="h-5 w-5" />
  </span>
  <h3
    class:list={[
      'font-bold text-slate-950',
      emphasized ? 'text-2xl tracking-tight' : 'text-lg',
    ]}
  >
    {feature.title}
  </h3>
  <p class:list={['mt-2 leading-6 text-slate-600', emphasized ? 'text-base' : 'text-sm']}>
    {feature.description}
  </p>
  {
    emphasized && (
      <ul class="mt-5 flex flex-wrap gap-2">
        {['Pesquisas', 'Explorar', 'Hashtags', 'Perfis de criadores', 'ZIP ou pasta'].map(
          (item) => (
            <li class="rounded-full border border-brand-200 bg-white px-3 py-1 text-xs font-semibold text-brand-700">
              {item}
            </li>
          ),
        )}
      </ul>
    )
  }
  <span
    class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700"
  >
    Conhecer recurso
    <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
  </span>
</a>
